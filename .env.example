# OpenAI 兼容 API 配置（scripts/run_loop.py 通过 python-dotenv 读取）
# 用法：复制本文件为 .env 并填入真实值：  cp .env.example .env
# 注意：.env 含密钥，务必确认已被 .gitignore 排除，不要提交。

# 你的 API key（取决于 BASE_URL 用哪家网关）
OPENAI_API_KEY=sk-xxx

# API 基地址（OpenAI 兼容）。
# 重要：run_loop.py 全局只用一个 BASE_URL，所有模型调用共用同一网关。
# 多模型混跑需它们经同一网关可达——推荐 OpenRouter（一个 key 覆盖 gemini/claude/deepseek）：
#   BASE_URL=https://openrouter.ai/api/v1
# 或各家官方兼容层（但一次只能跑一个家族，见 running-real-adaptation.md §3）：
#   DeepSeek:  BASE_URL=https://api.deepseek.com
#   Claude:    BASE_URL=https://api.anthropic.com/v1
#   Gemini:    BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
BASE_URL=https://openrouter.ai/api/v1

# 单目标默认模型（--multi 模式下此值被 --targets 覆盖）
MODEL=gpt-4o

# 独立裁判模型（C 档双模型 / 红队裁判用）；留空则同 MODEL 自评
JUDGE_MODEL=
